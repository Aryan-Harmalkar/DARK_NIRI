configuration {
    modi: "drun,run,ssh,window";
    show-icons: true;
    display-drun: "󰣆  Apps";
    display-run: "󱓞  Run";
    display-ssh: "󰣀  SSH";
    display-window: "󱂬  Windows";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg: #1a1b26E6; /* 90% opacity tokyo night background */
    bg-alt: #24283b;
    fg: #c0caf5;
    accent: #7aa2f7;
    border-color: #292e42;
    
    background-color: transparent;
    text-color: @fg;
    font: "Inter 12";
}

window {
    location: northwest;
    anchor: northwest;
    x-offset: 16px;
    y-offset: 56px;
    width: 380px;
    border: 1px;
    border-radius: 12px;
    border-color: @border-color;
    background-color: @bg;
}

mainbox {
    padding: 16px;
    spacing: 16px;
    children: [inputbar, listview, mode-switcher];
}

mode-switcher {
    spacing: 12px;
    background-color: transparent;
}

button {
    padding: 10px;
    background-color: @bg-alt;
    text-color: @fg;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border-radius: 8px;
    font: "Inter Bold 12";
}

button selected {
    background-color: @accent;
    text-color: #1a1b26;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px 16px;
    children: [prompt, entry];
    spacing: 12px;
}

prompt {
    text-color: @accent;
    font: "Inter Bold 12";
}

entry {
    placeholder: "Search...";
    placeholder-color: #565f89;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    lines: 8;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    border-radius: 8px;
    spacing: 12px;
}

element selected {
    background-color: @accent;
    text-color: #1a1b26;
}

element-text {
    vertical-align: 0.5;
    highlight: bold;
    text-color: inherit;
}

element-icon {
    size: 24px;
}
