// Niri configuration file (config.kdl)
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

spawn-at-startup "sh" "-c" "exec $HOME/DARK_NIRI/niri/startup.sh >/dev/null 2>&1"

hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        // accel-speed 0.2
    }
}

layout {
    gaps 16
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    default-column-width { proportion 0.5; }
    
    focus-ring {
        width 4
        active-color "#7c4dff"
        inactive-color "#303030"
    }

    border {
        width 2
        active-color "#ffc107"
        inactive-color "#505050"
    }
    
    struts {
        // Add a top margin for Quickshell if needed, but PanelWindow usually handles this
        // top 32
    }
}

// Window rules
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

binds {
    // Show keyboard shortcuts overlay
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launch applications
    Mod+Return { spawn "alacritty"; }
    Mod+Space { spawn "sh" "-c" "rofi -show drun -theme $HOME/DARK_NIRI/rofi/config.rasi"; }

    // Window management
    Alt+F { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    
    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // System
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Media and Volume
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh vol-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh vol-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh vol-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh bri-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "$HOME/DARK_NIRI/niri/osd.sh bri-down"; }

    // Screenshots
    Print { spawn "sh" "-c" "mkdir -p $HOME/SCREEN/screenshots && FILE=$HOME/SCREEN/screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png && grim -g \"$(slurp)\" $FILE && wl-copy < $FILE && notify-send 'Screenshot' 'Area saved & copied' -i accessories-screenshot"; }
    Mod+Print { spawn "sh" "-c" "mkdir -p $HOME/SCREEN/screenshots && FILE=$HOME/SCREEN/screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png && grim $FILE && wl-copy < $FILE && notify-send 'Screenshot' 'Fullscreen saved & copied' -i accessories-screenshot"; }

    // Clipboard Manager
    Mod+V { spawn "sh" "-c" "cliphist list | rofi -dmenu -theme $HOME/DARK_NIRI/rofi/config.rasi -p 'Clipboard' | cliphist decode | wl-copy"; }
}
